# PostgreSQL database connection
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=finguard

# Database admin credentials (table creation, loading, training)
DB_USER=postgres
DB_PASSWORD=your_admin_password_here

# Read-only user credentials (used by AI agent SQL tools)
DB_READONLY_USER=finguard_readonly
DB_READONLY_PASSWORD=your_readonly_password_here

# JWT authentication secret (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=your_jwt_secret_min_32_chars_here

